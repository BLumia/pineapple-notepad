       <widget class="QComboBox" name="kcfg_fileChangeDetectionBackend">
        <property name="toolTip">
         <string>File system watcher reports changes immediately while the document is open. Timestamp checking only looks at the file when the application is activated, the document is switched to, or a document is opened, which may behave more reliably on network drives.</string>
        </property>
        <item>
         <property name="text">
          <string>File system watcher (real-time)</string>
         </property>
        </item>
        <item>
         <property name="text">
